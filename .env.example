NODE_ENV=development
PORT=8000
FRONTEND_URL=http://localhost:3000
# Email va ijtimoiy havolalar uchun ochiq sayt manzili
PUBLIC_SITE_URL=https://maqolas.tm2.uz
PUBLIC_BASE_URL=http://localhost:8000

MONGODB_URI=mongodb://127.0.0.1:27017/maqolas

JWT_ACCESS_SECRET=your-access-secret-min-32-chars
JWT_REFRESH_SECRET=your-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret-from-google-console
GOOGLE_CALLBACK_URL=http://localhost:8000/api/auth/google/callback
# Mobil ilova Google Sign-In tokenlarini tasdiqlash uchun (Web client ID dan farqli)
GOOGLE_ANDROID_CLIENT_ID=your-android-client-id.apps.googleusercontent.com
GOOGLE_IOS_CLIENT_ID=your-ios-client-id.apps.googleusercontent.com

# Vergul bilan ajratilgan super admin email ro'yxati
SUPER_ADMIN_EMAILS=your-email@gmail.com

# Google AI Studio (Gemini) — https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key

# Email xabarlari (Gmail SMTP) — yangi maqola nashr etilganda barcha foydalanuvchilarga yuboriladi
EMAIL_FROM=uzmaqolas@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=uzmaqolas@gmail.com
SMTP_PASS=your-gmail-app-password

# Haftalik shaxsiy tavsiya emaili (yakshanba 10:00, Toshkent vaqti)
WEEKLY_DIGEST_ENABLED=true
WEEKLY_DIGEST_CRON=0 10 * * 0
WEEKLY_DIGEST_TIMEZONE=Asia/Tashkent
WEEKLY_DIGEST_MIN_DAYS=7
